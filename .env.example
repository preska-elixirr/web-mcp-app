# Copy to .env.local. Never commit secret keys. Only Stripe test keys are accepted.
STRIPE_SECRET_KEY=sk_test_replace_me
APP_URL=http://localhost:3000
# Optional: Stripe CLI / signed test webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Optional: WebMCP origin trial tokens. Each is bound to the exact origin it was registered for.
CHROME_ORIGIN_TRIAL_TOKEN=
EDGE_ORIGIN_TRIAL_TOKEN=
